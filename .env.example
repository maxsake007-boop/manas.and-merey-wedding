# Настройки отправки ответов гостей (RSVP)
# 1. Telegram Бот:
# Создайте бота через @BotFather, получите токен и вставьте сюда:
VITE_TELEGRAM_BOT_TOKEN=

# Узнайте свой Chat ID через бота @userinfobot или добавьте бота в группу/канал и укажите chat_id:
VITE_TELEGRAM_CHAT_ID=

# 2. Google Таблицы (по желанию):
# URL вебхука Google Apps Script
VITE_GOOGLE_SHEETS_URL=
